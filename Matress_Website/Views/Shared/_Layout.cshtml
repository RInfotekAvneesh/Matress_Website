@{
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string Active(string a) => string.Equals(action, a, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    bool transparentNav = action == "Index";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | Velora Living – Where Comfort Meets Luxury</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Velora Living – premium mattresses in Dubai, UAE. Where comfort Meets Luxury.")" />
    <meta name="theme-color" content="#0e2f25" />
    <link rel="icon" type="image/png" href="~/Image/web/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Top bar -->
    <div class="topbar d-none d-lg-block">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex gap-4">
                <a href="tel:+971545721826"><i class="bi bi-telephone"></i> +971 54 572 1826</a>
                <a href="mailto:veloraliving2026@gmail.com"><i class="bi bi-envelope"></i> veloraliving2026@gmail.com</a>
                <span><i class="bi bi-geo-alt"></i> Dubai, United Arab Emirates</span>
            </div>
            <partial name="_Social" />
        </div>
    </div>

    <header>
        <nav id="mainNav" class="navbar navbar-expand-lg fixed-nav @(transparentNav ? "nav-transparent" : "nav-solid")">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <img src="~/Image/web/logo.png" alt="Velora Living logo" class="brand-logo" />
                    <span class="brand-text">
                        <span class="brand-name">VELORA</span>
                        <span class="brand-sub">LIVING</span>
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu"
                        aria-controls="navMenu" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list"></i>
                </button>
                <div class="collapse navbar-collapse" id="navMenu">
                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        <li class="nav-item"><a class="nav-link @Active("Index")" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Collection")" asp-action="Collection">Collection</a></li>
                        <li class="nav-item"><a class="nav-link @Active("About")" asp-action="About">About Us</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Services")" asp-action="Services">Services</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Faq")" asp-action="Faq">FAQ</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Contact")" asp-action="Contact">Contact</a></li>
                        <li class="nav-item ms-lg-3 mt-2 mt-lg-0">
                            <a class="btn btn-gold btn-sm px-4" href="https://wa.me/971545721826" target="_blank" rel="noopener">
                                <i class="bi bi-whatsapp"></i> Order Now
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="@(transparentNav ? "" : "page-offset")">
        @RenderBody()
    </main>

    <!-- Newsletter / CTA strip -->
    <section class="cta-strip">
        <div class="container">
            <div class="row align-items-center g-4">
                <div class="col-lg-7 reveal">
                    <h3 class="mb-1">Ready to sleep like royalty?</h3>
                    <p class="mb-0">Free consultation, delivery across Dubai, and expert advice to find your perfect mattress.</p>
                </div>
                <div class="col-lg-5 text-lg-end reveal">
                    <a href="tel:+971545721826" class="btn btn-outline-light me-2 mb-2 mb-sm-0"><i class="bi bi-telephone"></i> Call Us</a>
                    <a href="https://wa.me/971545721826" target="_blank" rel="noopener" class="btn btn-gold"><i class="bi bi-whatsapp"></i> Chat on WhatsApp</a>
                </div>
            </div>
        </div>
    </section>

    <footer class="site-footer">
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-4 col-md-6">
                    <a asp-action="Index" class="d-inline-flex align-items-center gap-3 mb-3 text-decoration-none">
                        <img src="~/Image/web/logo.png" alt="Velora Living" class="footer-logo" />
                        <span>
                            <span class="d-block footer-brand">VELORA LIVING</span>
                            <span class="d-block footer-tag">Where Comfort Meets Luxury</span>
                        </span>
                    </a>
                    <p class="text-soft">Premium mattresses crafted for deep, restorative sleep. Proudly serving homes, hotels and apartments across Dubai and the UAE.</p>
                    <partial name="_Social" />
                </div>
                <div class="col-lg-2 col-md-6 col-6">
                    <h5>Explore</h5>
                    <ul class="footer-links">
                        <li><a asp-action="Index">Home</a></li>
                        <li><a asp-action="Collection">Our Collection</a></li>
                        <li><a asp-action="About">About Us</a></li>
                        <li><a asp-action="Services">Our Services</a></li>
                        <li><a asp-action="Faq">FAQ</a></li>
                        <li><a asp-action="Contact">Contact</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-6 col-6">
                    <h5>Mattresses</h5>
                    <ul class="footer-links">
                        @foreach (var c in Matress_Website.Models.Mattress.Categories)
                        {
                            <li><a asp-action="Collection" asp-fragment="@c.Key">@c.Label</a></li>
                        }
                    </ul>
                </div>
                <div class="col-lg-4 col-md-6">
                    <h5>Get in Touch</h5>
                    <ul class="footer-contact">
                        <li><i class="bi bi-geo-alt"></i><span>Dubai, United Arab Emirates</span></li>
                        <li><i class="bi bi-telephone"></i><a href="tel:+971545721826">+971 54 572 1826</a></li>
                        <li><i class="bi bi-envelope"></i><a href="mailto:veloraliving2026@gmail.com">veloraliving2026@gmail.com</a></li>
                      
                    </ul>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="container">
                &copy; 2026 DreamRest Mattresses. All Rights Reserved.
                <span class="mx-2">|</span>
                <a asp-action="Privacy">Privacy Policy</a>
                <span class="mx-2">|</span>
                <a asp-action="Terms">Terms &amp; Conditions</a>
            </div>
        </div>
    </footer>

    <!-- Floating buttons -->
    <a href="https://wa.me/971545721826" class="float-whatsapp" target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
        <i class="bi bi-whatsapp"></i>
    </a>
    <button type="button" class="back-to-top" aria-label="Back to top"><i class="bi bi-arrow-up"></i></button>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
