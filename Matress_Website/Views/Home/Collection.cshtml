@model List<Matress_Website.Models.Mattress>
@{
    ViewData["Title"] = "Our Mattress Collection";
    ViewData["PageHeading"] = "Our Mattress Collection";
    ViewData["PageSub"] = "Luxury comfort for every sleeper, every body and every bedroom.";
    ViewData["PageImage"] = "room-wood.jpg";
    ViewData["Description"] = "Browse Velora Living mattresses: pocket spring, memory foam, orthopedic, natural latex, hybrid and kids mattresses in Dubai.";
}

<partial name="_PageHeader" />

<section class="section">
    <div class="container">
        <!-- Toolbar -->
        <div class="collection-toolbar reveal">
            <div class="filter-pills" role="group" aria-label="Filter by type">
                <button type="button" class="active" data-filter="all">All</button>
                @foreach (var c in Matress_Website.Models.Mattress.Categories)
                {
                    <button type="button" data-filter="@c.Key">@c.Label</button>
                }
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <div class="search-box">
                    <i class="bi bi-search"></i>
                    <input type="search" id="productSearch" class="form-control" placeholder="Search mattresses..." aria-label="Search mattresses" />
                </div>
                <select id="productSort" class="form-select" aria-label="Sort mattresses">
                    <option value="default">Sort: Featured</option>
                    <option value="soft">Softest first</option>
                    <option value="firm">Firmest first</option>
                    <option value="name">Name A–Z</option>
                </select>
            </div>
        </div>

        <p class="text-muted small mb-4 reveal"><span id="resultCount">@Model.Count</span> mattresses found</p>

        <div class="row g-4" id="productGrid">
            @foreach (var m in Model)
            {
                <div class="col-sm-6 col-lg-4 product-col reveal">
                    <partial name="_ProductCard" model="m" />
                </div>
            }
        </div>
        <div id="noResults" class="text-center py-5 d-none">
            <i class="bi bi-search display-5 text-gold"></i>
            <p class="mt-3">No mattresses match your search. Try a different keyword or filter.</p>
        </div>
    </div>
</section>

<!-- SIZE GUIDE -->
<section class="section bg-cream">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-5 reveal">
                <span class="eyebrow">Size Guide</span>
                <h2 class="section-title">Available in Every Size</h2>
                <p>All Velora mattresses are available in standard UAE sizes. Need something special for a custom bed frame, yacht or hotel room? We make custom sizes too.</p>
                <a href="https://wa.me/971545721826?text=@Uri.EscapeDataString("Hello Velora Living, I need a custom size mattress.")" target="_blank" rel="noopener" class="btn btn-dark-green"><i class="bi bi-rulers"></i> Request Custom Size</a>
            </div>
            <div class="col-lg-7 reveal">
                <div class="table-responsive size-table">
                    <table class="table mb-0">
                        <thead><tr><th>Size</th><th>Dimensions</th><th>Ideal For</th></tr></thead>
                        <tbody>
                            <tr><td>Single</td><td>90 x 190 cm</td><td>Kids, teens, guest rooms</td></tr>
                            <tr><td>Double</td><td>120 x 200 cm</td><td>Single adults, small rooms</td></tr>
                            <tr><td>Queen</td><td>160 x 200 cm</td><td>Couples, master bedrooms</td></tr>
                            <tr><td>King</td><td>180 x 200 cm</td><td>Couples who like extra space</td></tr>
                            <tr><td>Super King</td><td>200 x 200 cm</td><td>Families &amp; luxury suites</td></tr>
                            <tr><td>Custom</td><td>Made to measure</td><td>Special frames &amp; hospitality</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- FIRMNESS GUIDE -->
<section class="section">
    <div class="container">
        <div class="text-center mb-5 reveal">
            <span class="eyebrow">Firmness Guide</span>
            <h2 class="section-title">Choose Your Feel</h2>
        </div>
        <div class="row g-4 text-center">
            <div class="col-6 col-lg-3 reveal"><div class="firm-guide"><div class="firm-dot" style="--lvl:25%"></div><h5>Plush</h5><p>Soft, cloud-like feel. Great for side sleepers.</p></div></div>
            <div class="col-6 col-lg-3 reveal"><div class="firm-guide"><div class="firm-dot" style="--lvl:50%"></div><h5>Medium</h5><p>Balanced comfort and support for most sleepers.</p></div></div>
            <div class="col-6 col-lg-3 reveal"><div class="firm-guide"><div class="firm-dot" style="--lvl:70%"></div><h5>Medium-Firm</h5><p>Supportive with a comfort top. Ideal for couples.</p></div></div>
            <div class="col-6 col-lg-3 reveal"><div class="firm-guide"><div class="firm-dot" style="--lvl:90%"></div><h5>Firm</h5><p>Maximum support for back and stomach sleepers.</p></div></div>
        </div>
    </div>
</section>
