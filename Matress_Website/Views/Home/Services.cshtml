@{
    ViewData["Title"] = "Our Services";
    ViewData["PageHeading"] = "Our Services";
    ViewData["PageSub"] = "More than mattresses: a complete luxury sleep experience.";
    ViewData["PageImage"] = "room-classic.jpg";
    ViewData["Description"] = "Velora Living services in Dubai: free sleep consultation, delivery and setup, custom sizes, hotel and bulk supply, old mattress removal.";
}

<partial name="_PageHeader" />

<section class="section">
    <div class="container">
        <div class="text-center mb-5 reveal">
            <span class="eyebrow">What We Offer</span>
            <h2 class="section-title">Service Designed Around You</h2>
            <p class="section-sub">From choosing your mattress to setting it up in your bedroom, we take care of everything.</p>
        </div>
        <div class="row g-4">
            <div class="col-md-6 col-lg-4 reveal">
                <div class="service-card">
                    <div class="service-icon"><i class="bi bi-chat-square-heart"></i></div>
                    <h4>Free Sleep Consultation</h4>
                    <p>Tell us how you sleep and our experts will recommend the right firmness, material and size, in store, by phone or on WhatsApp.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4 reveal">
                <div class="service-card">
                    <div class="service-icon"><i class="bi bi-truck"></i></div>
                    <h4>Home Delivery</h4>
                    <p>Reliable, careful delivery across Dubai with options across the UAE. We'll schedule a time that suits you.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4 reveal">
                <div class="service-card">
                    <div class="service-icon"><i class="bi bi-tools"></i></div>
                    <h4>Installation &amp; Setup</h4>
                    <p>Our team unpacks, positions and sets up your new mattress, and takes the packaging away with them.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4 reveal">
                <div class="service-card">
                    <div class="service-icon"><i class="bi bi-rulers"></i></div>
                    <h4>Custom-Size Mattresses</h4>
                    <p>Unusual bed frame, round bed or built-in platform? We produce mattresses made to your exact measurements.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4 reveal">
                <div class="service-card">
                    <div class="service-icon"><i class="bi bi-buildings"></i></div>
                    <h4>Hotel &amp; Bulk Supply</h4>
                    <p>Hospitality-grade mattresses for hotels, holiday homes, serviced apartments and staff accommodation, with volume pricing.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4 reveal">
                <div class="service-card">
                    <div class="service-icon"><i class="bi bi-recycle"></i></div>
                    <h4>Old Mattress Removal</h4>
                    <p>Upgrading? Ask us to collect and responsibly dispose of your old mattress when we deliver your new one.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4 reveal">
                <div class="service-card">
                    <div class="service-icon"><i class="bi bi-layers"></i></div>
                    <h4>Toppers, Pillows &amp; Protectors</h4>
                    <p>Complete your bed with matching mattress toppers, pillows and waterproof protectors.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4 reveal">
                <div class="service-card">
                    <div class="service-icon"><i class="bi bi-shield-check"></i></div>
                    <h4>After-Sales Support</h4>
                    <p>Questions after delivery? Our team is a message away for care tips, warranty help and support.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-4 reveal">
                <div class="service-card">
                    <div class="service-icon"><i class="bi bi-house-heart"></i></div>
                    <h4>Interior Matching</h4>
                    <p>Get advice on pairing your mattress with bed frames, headboards and bedding for a complete luxury look.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- PROCESS -->
<section class="section bg-cream">
    <div class="container">
        <div class="text-center mb-5 reveal">
            <span class="eyebrow">How It Works</span>
            <h2 class="section-title">From Enquiry to Better Sleep in 4 Steps</h2>
        </div>
        <div class="row g-4 process">
            <div class="col-6 col-lg-3 reveal"><div class="step"><span>1</span><h5>Reach Out</h5><p>Call, email or WhatsApp us with your needs.</p></div></div>
            <div class="col-6 col-lg-3 reveal"><div class="step"><span>2</span><h5>Get Advice</h5><p>We recommend the perfect mattress and size.</p></div></div>
            <div class="col-6 col-lg-3 reveal"><div class="step"><span>3</span><h5>Confirm Order</h5><p>Receive a clear quote and choose your delivery slot.</p></div></div>
            <div class="col-6 col-lg-3 reveal"><div class="step"><span>4</span><h5>Sleep in Luxury</h5><p>We deliver, set up, and you enjoy deep, restful sleep.</p></div></div>
        </div>
    </div>
</section>

<!-- B2B -->
<section class="section">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-6 reveal">
                <img src="~/Image/web/lounge.jpg" alt="Luxury hospitality interior" class="img-fluid rounded-4 shadow-lg" loading="lazy" />
            </div>
            <div class="col-lg-6 reveal">
                <span class="eyebrow">For Businesses</span>
                <h2 class="section-title">Hospitality &amp; Corporate Solutions</h2>
                <p>Dubai's hospitality sector demands the very best. Velora Living supplies durable, comfortable mattresses for:</p>
                <ul class="check-list two-col my-4">
                    <li>Hotels &amp; resorts</li>
                    <li>Holiday homes</li>
                    <li>Serviced apartments</li>
                    <li>Real estate &amp; fit-outs</li>
                    <li>Staff accommodation</li>
                    <li>Interior designers</li>
                </ul>
                <a href="https://wa.me/971545721826?text=@Uri.EscapeDataString("Hello Velora Living, I'd like a bulk / business quotation.")" target="_blank" rel="noopener" class="btn btn-dark-green"><i class="bi bi-briefcase"></i> Request a Business Quote</a>
            </div>
        </div>
    </div>
</section>
