@model List<Matress_Website.Models.Mattress>
@{
    ViewData["Title"] = "Home";
    ViewData["Description"] = "Velora Living – luxury mattresses in Dubai. Pocket spring, memory foam, orthopedic and latex mattresses with delivery across the UAE.";
}

<!-- HERO -->
<section class="hero">
    <div id="heroCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel" data-bs-interval="6000">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
        </div>
        <div class="carousel-inner">
            <div class="carousel-item active" style="background-image:url('@Url.Content("~/Image/web/room-gold.jpg")')">
                <div class="hero-overlay"></div>
                <div class="container hero-content">
                    <span class="eyebrow">Luxury Mattresses &middot; Dubai</span>
                    <h1>Where Comfort<br /><em>Meets Luxury</em></h1>
                    <p>Hand-picked premium mattresses that turn every night into a five-star stay. Delivered to your door across Dubai &amp; the UAE.</p>
                    <div class="d-flex flex-wrap gap-3">
                        <a asp-action="Collection" class="btn btn-gold btn-lg">Explore Collection</a>
                        <a href="#finder" class="btn btn-outline-light btn-lg">Find My Mattress</a>
                    </div>
                </div>
            </div>
            <div class="carousel-item" style="background-image:url('@Url.Content("~/Image/web/room-classic.jpg")')">
                <div class="hero-overlay"></div>
                <div class="container hero-content">
                    <span class="eyebrow">Hotel-Grade Comfort</span>
                    <h1>Sleep Like You're<br /><em>On Holiday</em></h1>
                    <p>The same plush, supportive feel you love in Dubai's finest hotels, made for your own bedroom.</p>
                    <div class="d-flex flex-wrap gap-3">
                        <a asp-action="Collection" class="btn btn-gold btn-lg">Shop Mattresses</a>
                        <a asp-action="Services" class="btn btn-outline-light btn-lg">Our Services</a>
                    </div>
                </div>
            </div>
            <div class="carousel-item" style="background-image:url('@Url.Content("~/Image/web/room-skyline.jpg")')">
                <div class="hero-overlay"></div>
                <div class="container hero-content">
                    <span class="eyebrow">Made for UAE Nights</span>
                    <h1>Stay Cool,<br /><em>Sleep Deep</em></h1>
                    <p>Breathable, cooling materials engineered for warm climates, so you wake up fresh every morning.</p>
                    <div class="d-flex flex-wrap gap-3">
                        <a href="https://wa.me/971545721826" target="_blank" rel="noopener" class="btn btn-gold btn-lg"><i class="bi bi-whatsapp"></i> Free Consultation</a>
                        <a asp-action="Contact" class="btn btn-outline-light btn-lg">Contact Us</a>
                    </div>
                </div>
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span><span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span><span class="visually-hidden">Next</span>
        </button>
    </div>
    <a href="#features" class="scroll-down" aria-label="Scroll down"><i class="bi bi-chevron-double-down"></i></a>
</section>

<!-- FEATURE STRIP -->
<section id="features" class="feature-strip">
    <div class="container">
        <div class="row g-4">
            <div class="col-6 col-lg-3 reveal">
                <div class="feature-item"><i class="bi bi-truck"></i><div><h6>Fast Delivery</h6><span>Across Dubai &amp; UAE</span></div></div>
            </div>
            <div class="col-6 col-lg-3 reveal">
                <div class="feature-item"><i class="bi bi-shield-check"></i><div><h6>Quality Assured</h6><span>Premium materials</span></div></div>
            </div>
            <div class="col-6 col-lg-3 reveal">
                <div class="feature-item"><i class="bi bi-rulers"></i><div><h6>Custom Sizes</h6><span>Made to fit</span></div></div>
            </div>
            <div class="col-6 col-lg-3 reveal">
                <div class="feature-item"><i class="bi bi-headset"></i><div><h6>Expert Advice</h6><span>Free sleep consultation</span></div></div>
            </div>
        </div>
    </div>
</section>

<!-- WELCOME -->
<section class="section">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6 reveal">
                <div class="img-stack">
                    <img src="~/Image/web/products/pillowtop-1.jpg" alt="Luxury bedroom with Velora mattress" class="img-main" loading="lazy" />
                    <img src="~/Image/web/couple.jpg" alt="Couple relaxing on a comfortable bed" class="img-float" loading="lazy" />
                    <div class="exp-badge"><strong>100%</strong><span>Comfort<br />Focused</span></div>
                </div>
            </div>
            <div class="col-lg-6 reveal">
                <span class="eyebrow">Welcome to Velora Living</span>
                <h2 class="section-title">Luxury Sleep, Thoughtfully Crafted for Dubai Homes</h2>
                <p>At <strong>Velora Living</strong>, we believe a great day begins with a great night. Our mattresses bring together premium materials, expert craftsmanship and elegant design, so every bedroom feels like a luxury suite.</p>
                <p>Whether you need gentle cushioning, firm orthopedic support or a cooling surface for warm UAE nights, our sleep experts will help you choose the mattress that fits your body and lifestyle.</p>
                <ul class="check-list two-col my-4">
                    <li>Bonnell &amp; pocket springs</li>
                    <li>Breathable knitted fabrics</li>
                    <li>Medical spine support</li>
                    <li>Hypoallergenic materials</li>
                    <li>Custom &amp; hotel sizes</li>
                    <li>Delivery &amp; setup</li>
                </ul>
                <a asp-action="About" class="btn btn-dark-green">Discover Our Story</a>
            </div>
        </div>
    </div>
</section>

<!-- FEATURED COLLECTION -->
<section class="section bg-cream">
    <div class="container">
        <div class="text-center mb-5 reveal">
            <span class="eyebrow">Our Mattress Collection</span>
            <h2 class="section-title">Find Your Perfect Comfort</h2>
            <p class="section-sub">Medical, Bonnell Spring, Pocket Spring, Folding Foam, Euro Top and Pillow Top. Every Velora mattress is designed for deeper, more restful sleep.</p>
        </div>
        <div class="row g-4">
            @foreach (var m in Model)
            {
                <div class="col-sm-6 col-lg-4 reveal">
                    <partial name="_ProductCard" model="m" />
                </div>
            }
        </div>
        <div class="text-center mt-5 reveal">
            <a asp-action="Collection" class="btn btn-dark-green btn-lg">View Full Collection <i class="bi bi-arrow-right"></i></a>
        </div>
    </div>
</section>

<!-- INSIDE THE MATTRESS -->
<section class="section">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-6 order-lg-2 reveal">
                <img src="~/Image/web/products/layers.jpg" alt="Layers inside a Velora mattress" class="img-fluid rounded-4 shadow-lg" loading="lazy" />
            </div>
            <div class="col-lg-6 reveal">
                <span class="eyebrow">Crafted in Layers</span>
                <h2 class="section-title">What Makes a Velora Mattress</h2>
                <p>Every Velora mattress is built layer by layer for the right balance of comfort, support and durability.</p>
                <ul class="check-list my-4">
                    <li><strong>Soft knitted fabric cover</strong>: breathable, smooth and gentle on skin</li>
                    <li><strong>Comfort layers</strong>: plush foams that cushion pressure points</li>
                    <li><strong>Support core</strong>: springs or high-density foam that keep your spine aligned</li>
                    <li><strong>Reinforced, piped edges</strong>: a neat finish that holds its shape</li>
                </ul>
                <a asp-action="Collection" class="btn btn-dark-green">Compare Mattresses</a>
            </div>
        </div>
    </div>
</section>

<!-- MATTRESS FINDER -->
<section id="finder" class="section finder-section">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-5 reveal">
                <span class="eyebrow">Mattress Finder</span>
                <h2 class="section-title text-white">Not Sure Which Mattress Is Right for You?</h2>
                <p class="text-soft">Answer three quick questions and we'll recommend the Velora mattress that suits the way you sleep.</p>
            </div>
            <div class="col-lg-7 reveal">
                <div class="finder-card" id="finderCard">
                    <div class="finder-progress"><span style="width:33%"></span></div>
                    <div class="finder-step active" data-step="1">
                        <h5>1. How do you usually sleep?</h5>
                        <div class="finder-options">
                            <button type="button" data-key="pos" data-val="side"><i class="bi bi-person"></i>On my side</button>
                            <button type="button" data-key="pos" data-val="back"><i class="bi bi-person-standing"></i>On my back</button>
                            <button type="button" data-key="pos" data-val="stomach"><i class="bi bi-person-down"></i>On my stomach</button>
                        </div>
                    </div>
                    <div class="finder-step" data-step="2">
                        <h5>2. Do you have back or joint pain?</h5>
                        <div class="finder-options">
                            <button type="button" data-key="pain" data-val="yes"><i class="bi bi-bandaid"></i>Yes, often</button>
                            <button type="button" data-key="pain" data-val="no"><i class="bi bi-emoji-smile"></i>No, not really</button>
                        </div>
                    </div>
                    <div class="finder-step" data-step="3">
                        <h5>3. Do you tend to sleep hot?</h5>
                        <div class="finder-options">
                            <button type="button" data-key="hot" data-val="yes"><i class="bi bi-thermometer-sun"></i>Yes, I feel warm</button>
                            <button type="button" data-key="hot" data-val="no"><i class="bi bi-snow"></i>No, I'm fine</button>
                        </div>
                    </div>
                    <div class="finder-step finder-result" data-step="4">
                        <span class="eyebrow">We recommend</span>
                        <h4 id="finderName"></h4>
                        <p id="finderWhy"></p>
                        <div class="d-flex flex-wrap gap-2">
                            <a id="finderWa" class="btn btn-gold" target="_blank" rel="noopener" href="https://wa.me/971545721826"><i class="bi bi-whatsapp"></i> Ask About This Mattress</a>
                            <button type="button" class="btn btn-outline-light" id="finderReset"><i class="bi bi-arrow-counterclockwise"></i> Start Again</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- STATS -->
<section class="stats-section" style="background-image:url('@Url.Content("~/Image/web/dubai-marina.jpg")')">
    <div class="container position-relative">
        <div class="row g-4 text-center">
            <div class="col-6 col-md-3 reveal"><div class="stat"><span class="counter" data-target="6">0</span><small>Mattress Types</small></div></div>
            <div class="col-6 col-md-3 reveal"><div class="stat"><span class="counter" data-target="4">0</span><small>Firmness Levels</small></div></div>
            <div class="col-6 col-md-3 reveal"><div class="stat"><span class="counter" data-target="6">0</span><small>Size Options incl. Custom</small></div></div>
            <div class="col-6 col-md-3 reveal"><div class="stat"><span class="counter" data-target="100" data-suffix="%">0</span><small>Comfort Focused</small></div></div>
        </div>
    </div>
</section>

<!-- WHY CHOOSE -->
<section class="section">
    <div class="container">
        <div class="text-center mb-5 reveal">
            <span class="eyebrow">Why Velora Living</span>
            <h2 class="section-title">The Velora Difference</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-6 col-lg-4 reveal">
                <div class="why-card"><i class="bi bi-gem"></i><h4>Luxury Materials</h4><p>Premium springs, high-density foams, natural latex and soft-touch fabrics selected for comfort and durability.</p></div>
            </div>
            <div class="col-md-6 col-lg-4 reveal">
                <div class="why-card"><i class="bi bi-thermometer-snow"></i><h4>Climate-Smart Comfort</h4><p>Breathable layers and cooling gel technology made for the warm Dubai climate.</p></div>
            </div>
            <div class="col-md-6 col-lg-4 reveal">
                <div class="why-card"><i class="bi bi-heart-pulse"></i><h4>Healthy Sleep Posture</h4><p>Supportive cores and zoned comfort keep your spine naturally aligned all night.</p></div>
            </div>
            <div class="col-md-6 col-lg-4 reveal">
                <div class="why-card"><i class="bi bi-tag"></i><h4>Honest Pricing</h4><p>Luxury quality without the showroom markup. Get a clear quote directly on WhatsApp.</p></div>
            </div>
            <div class="col-md-6 col-lg-4 reveal">
                <div class="why-card"><i class="bi bi-buildings"></i><h4>Homes &amp; Hospitality</h4><p>Bulk supply for hotels, holiday homes, serviced apartments and staff accommodation.</p></div>
            </div>
            <div class="col-md-6 col-lg-4 reveal">
                <div class="why-card"><i class="bi bi-chat-heart"></i><h4>Personal Service</h4><p>Friendly sleep experts who guide you before, during and after your purchase.</p></div>
            </div>
        </div>
    </div>
</section>

<!-- TESTIMONIALS -->
