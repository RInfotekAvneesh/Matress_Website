@{
    ViewData["Title"] = "About Us";
    ViewData["PageHeading"] = "About Velora Living";
    ViewData["PageSub"] = "Where Comfort Meets Luxury";
    ViewData["PageImage"] = "lounge.jpg";
    ViewData["Description"] = "Learn about Velora Living, a Dubai mattress brand. Our story, mission, vision and values.";
}

<partial name="_PageHeader" />

<!-- STORY -->
<section class="section">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-6 reveal">
                <span class="eyebrow">Our Story</span>
                <h2 class="section-title">Born in Dubai, Inspired by Five-Star Comfort</h2>
                <p><strong>VELORA LIVING – Where Comfort Meets Luxury</strong> was founded in Dubai with a simple belief: everyone deserves to sleep like they're staying in a luxury hotel, every single night.</p>
                <p>Dubai is a city known for world-class hospitality. We wanted to bring that same feeling of indulgent comfort home. So we carefully select materials, construction and finishes that combine plush comfort, healthy support and lasting durability.</p>
                <p>Today, Velora Living serves families, professionals, holiday homes and hospitality businesses across the UAE, with a personal, friendly approach that makes choosing a mattress simple.</p>
                <div class="d-flex align-items-center gap-3 mt-4">
                    <img src="~/Image/web/logo.png" alt="Velora Living logo" class="about-logo" />
                    <div>
                        <h6 class="mb-0 font-serif fs-5">Velora Living</h6>
                        <small class="text-muted">Dubai, United Arab Emirates</small>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 reveal">
                <div class="img-stack">
                    <img src="~/Image/web/room-gold.jpg" alt="Elegant Velora bedroom" class="img-main" loading="lazy" />
                    <img src="~/Image/web/burj.jpg" alt="Burj Khalifa, Dubai" class="img-float" loading="lazy" />
                </div>
            </div>
        </div>
    </div>
</section>

<!-- MISSION / VISION -->
<section class="section bg-cream" id="mission">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-6 reveal">
                <div class="mv-card">
                    <div class="mv-icon"><i class="bi bi-bullseye"></i></div>
                    <h3>Our Mission</h3>
                    <p>To transform the way people in the UAE sleep by offering luxurious, supportive and affordable mattresses, backed by honest advice and genuinely caring service, so every customer wakes up refreshed, healthy and ready for the day.</p>
                </div>
            </div>
            <div class="col-lg-6 reveal" id="vision">
                <div class="mv-card">
                    <div class="mv-icon"><i class="bi bi-eye"></i></div>
                    <h3>Our Vision</h3>
                    <p>To become the most trusted luxury sleep brand in the UAE and the region, recognised for elegant design, exceptional comfort and a customer experience as refined as the city we call home.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- VALUES -->
<section class="section" id="values">
    <div class="container">
        <div class="text-center mb-5 reveal">
            <span class="eyebrow">What We Stand For</span>
            <h2 class="section-title">Our Values</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-6 col-lg-4 reveal"><div class="value-card"><span>01</span><i class="bi bi-gem"></i><h4>Luxury in Every Detail</h4><p>From the stitching to the springs, we never compromise on the quality you can feel.</p></div></div>
            <div class="col-md-6 col-lg-4 reveal"><div class="value-card"><span>02</span><i class="bi bi-heart"></i><h4>Customer First</h4><p>We listen, advise honestly and stay with you long after your mattress is delivered.</p></div></div>
            <div class="col-md-6 col-lg-4 reveal"><div class="value-card"><span>03</span><i class="bi bi-patch-check"></i><h4>Integrity</h4><p>Clear pricing, accurate information and promises we keep, every time.</p></div></div>
            <div class="col-md-6 col-lg-4 reveal"><div class="value-card"><span>04</span><i class="bi bi-activity"></i><h4>Health &amp; Wellbeing</h4><p>Better sleep means a better life. We design for posture, pressure relief and hygiene.</p></div></div>
            <div class="col-md-6 col-lg-4 reveal"><div class="value-card"><span>05</span><i class="bi bi-lightbulb"></i><h4>Innovation</h4><p>We embrace new sleep technologies, from cooling gels to zoned support systems.</p></div></div>
            <div class="col-md-6 col-lg-4 reveal"><div class="value-card"><span>06</span><i class="bi bi-tree"></i><h4>Responsibility</h4><p>We choose durable, longer-lasting products and responsible materials wherever possible.</p></div></div>
        </div>
    </div>
</section>

<!-- BANNER -->
<section class="brand-banner reveal">
    <img src="~/Image/web/cover.jpg" alt="Velora Living – Where Comfort Meets Luxury" loading="lazy" />
</section>
